{
  "name": "chatbox-pro",
  "private": true,
  "version": "0.1.0",
  "description": "ChatBox Pro — 手机/电脑访问 DeepSeek 与 DSH 的客户端",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/index.mjs",
    "serve": "npm run build && node server/index.mjs",
    "typecheck": "tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "marked": "^15.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.65.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
